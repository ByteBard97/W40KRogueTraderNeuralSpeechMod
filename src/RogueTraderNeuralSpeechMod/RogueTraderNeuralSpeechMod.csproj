<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>W40KRT_NeuralSpeechMod</AssemblyName>
    <RootNamespace>NeuralSpeechMod</RootNamespace>
    <Description>Warhammer 40K: Rogue Trader - Neural Speech Mod (local neural TTS via sidecar; fork of Osmodium's SpeechMod)</Description>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(RogueTraderManaged)/0Harmony.dll" Private="false" />
    <Reference Include="$(RogueTraderManaged)/Code.dll" Publicize="true" Private="false" />
    <Reference Include="$(RogueTraderManaged)/Kingmaker*.dll" Publicize="true" Private="false" />
    <Reference Include="$(RogueTraderManaged)/LocalizationShared.dll" Private="false" />
    <Reference Include="$(RogueTraderManaged)/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="$(RogueTraderManaged)/Owlcat*.dll" Publicize="true" Private="false" />
    <Reference Include="$(RogueTraderManaged)/UniRx.dll" Private="false" />
    <Reference Include="$(RogueTraderManaged)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(RogueTraderManaged)/UnityEngine*.dll" Private="false" />
    <Reference Include="$(RogueTraderManaged)/RogueTrader*.dll" Publicize="true" Private="false" />
    <Reference Include="$(RogueTraderModsDir)/UnityModManager.dll" Publicize="true" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Info.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Localization/enGB.json" CopyToOutputDirectory="PreserveNewest" Link="Localization/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" IncludeAssets="build; contentfiles" />
    <PackageReference Include="MicroUtils.HarmonyAnalyzers" Version="*-*" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

  <!-- `dotnet build -t:Deploy` copies the built mod into the game's UnityModManager folder. -->
  <Target Name="Deploy" DependsOnTargets="Build">
    <ItemGroup>
      <ModFiles Include="$(TargetDir)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModFiles)" DestinationFiles="@(ModFiles->'$(RogueTraderModsDir)/$(AssemblyName)/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="Deployed to $(RogueTraderModsDir)/$(AssemblyName)" />
  </Target>

</Project>
